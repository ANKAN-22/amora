# Supabase → Project Settings → API. Restart `npm run dev` after changing these.
# On Vercel, set only these two. Do not add the reviewer password there.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local reviewer login only. Leave these blank on the live site.
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=
